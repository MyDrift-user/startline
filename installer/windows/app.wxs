<!-- Built by installer\windows\package.ps1.
     Silent, for this PC, from an admin prompt: msiexec /i name.msi /qn ALLUSERS=1 [APPLICATIONFOLDER="D:\Apps\Startline"]
     Silent, for one account, no admin needed: msiexec /i name.msi /qn ALLUSERS=2 MSIINSTALLPERUSER=1 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Startline" Manufacturer="MyDrift" Version="$(var.Version)" UpgradeCode="6F0B6C1E-3A52-4E8D-9C47-2D1E7A94B3C5" Scope="perUserOrMachine">
    <!-- Same version too: the 0.1.0 test builds have to be replaced by the 0.1.0 release, not sit next to it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Startline is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="app.ico" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MyDrift-user/startline" />
    <Property Id="ApplicationFolderName" Value="Startline" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
    <!-- The wizard's own defaults are the 32-bit Program Files, and Apps instead of the usual Programs. -->
    <SetProperty Id="WixPerMachineFolder" Value="[ProgramFiles64Folder][ApplicationFolderName]" After="WixSetDefaultPerMachineFolder" Sequence="both" />
    <SetProperty Id="WixPerUserFolder" Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]" After="WixSetDefaultPerUserFolder" Sequence="both" />
    <WixVariable Id="WixUILicenseRtf" Value="target\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="installer\windows\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="installer\windows\dialog.bmp" />
    <!-- Offers this PC or just this account, and works on the folder called APPLICATIONFOLDER below. -->
    <ui:WixUI Id="WixUI_Advanced" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Startline" />
    </StandardDirectory>
    <Component Directory="APPLICATIONFOLDER">
      <File Source="target\release\startline.exe" Name="startline.exe" KeyPath="yes">
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Startline" WorkingDirectory="APPLICATIONFOLDER" Icon="app.ico" Advertise="no" />
      </File>
    </Component>
    <!-- On its own: the program has no version resource, so WiX can only make IDs for one-file components. -->
    <Component Directory="APPLICATIONFOLDER">
      <File Source="LICENSE" Name="LICENSE.txt" />
    </Component>
    <!-- Startline stays running in the background, so it would otherwise always hold its own file during an upgrade or uninstall. -->
    <CustomAction Id="CloseStartline" Directory="APPLICATIONFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand='"[SystemFolder]taskkill.exe" /f /im startline.exe' />
    <!-- Its Start with Windows switch writes this for the account. Without this it would point at a deleted program. -->
    <CustomAction Id="DeleteAutostart" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand='"[SystemFolder]reg.exe" delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v Startline /f' />
    <!-- Marks a PC-wide install. See src/update.rs. -->
    <Component Directory="APPLICATIONFOLDER" Condition="ALLUSERS=1">
      <File Source="installer\windows\machine-install.txt" />
    </Component>
    <!-- For a PC-wide install: installs updates as SYSTEM, so nobody gets an admin prompt. See src/update.rs.
         The task runs this folder's program as SYSTEM, so only admins may change it, wherever it was installed.
         The install fails rather than go on if that can't be done.
         Only on the folder, as files inherit from it: with /T the same command leaves files with no permissions. -->
    <CustomAction Id="LockInstallFolder" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand='"[SystemFolder]icacls.exe" "[APPLICATIONFOLDER]." /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F *S-1-5-32-545:(OI)(CI)RX /C' />
    <CustomAction Id="CreateUpdateTask" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand='"[SystemFolder]schtasks.exe" /Create /F /TN "Startline Updater" /SC HOURLY /RU SYSTEM /RL HIGHEST /TR "\"[APPLICATIONFOLDER]startline.exe\" --update-service"' />
    <CustomAction Id="DeleteUpdateTask" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand='"[SystemFolder]schtasks.exe" /Delete /F /TN "Startline Updater"' />
    <!-- Only when really uninstalling: an upgrade first removes the old version, and the installer running it is in this folder. -->
    <CustomAction Id="DeleteUpdates" Directory="APPLICATIONFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand='"[SystemFolder]cmd.exe" /c rmdir /s /q "[APPLICATIONFOLDER]updates"' />
    <InstallExecuteSequence>
      <Custom Action="CloseStartline" Before="InstallValidate" Condition='REMOVE="ALL" OR WIX_UPGRADE_DETECTED' />
      <Custom Action="DeleteAutostart" Before="RemoveFiles" Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="DeleteUpdates" Before="RemoveFiles" Condition='ALLUSERS=1 AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="DeleteUpdateTask" Before="RemoveFiles" Condition='ALLUSERS=1 AND REMOVE="ALL"' />
      <Custom Action="LockInstallFolder" After="InstallFiles" Condition='ALLUSERS=1 AND NOT REMOVE="ALL"' />
      <Custom Action="CreateUpdateTask" Before="InstallFinalize" Condition='ALLUSERS=1 AND NOT REMOVE="ALL"' />
    </InstallExecuteSequence>
  </Package>
</Wix>
