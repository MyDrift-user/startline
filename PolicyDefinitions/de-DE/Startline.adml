  <displayName>Startline</displayName>
  <description>Einstellungen für das Startmenü und die Suche von Startline.</description>
  <resources>
    <stringTable>
      <string id="Supported">Startline 0.1 und höher</string>
      <string id="Cat_Startline">Startline</string>
