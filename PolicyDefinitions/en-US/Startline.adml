<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.1" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Startline</displayName>
  <description>Settings for the Startline Start menu and search.</description>
  <resources>
    <stringTable>
      <string id="Supported">Startline 0.1 and later</string>
      <string id="Cat_Startline">Startline</string>
      <string id="Cat_Rec_Startline">Defaults people can change</string>
      <string id="Cat_Search">Search</string>
      <string id="Cat_Appearance">Appearance</string>
