<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="startline" namespace="Startline.Policies.Startline"/>
  </policyNamespaces>
  <resources minRequiredRevision="1.0" fallbackCulture="en-us"/>
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Startline" displayName="$(string.Supported)"/>
    </definitions>
  </supportedOn>
  <categories>
    <category name="Startline" displayName="$(string.Cat_Startline)"/>
    <category name="Appearance" displayName="$(string.Cat_Appearance)">
      <parentCategory ref="Startline"/>
    </category>
    <category name="StartMenu" displayName="$(string.Cat_StartMenu)">
      <parentCategory ref="Startline"/>
    </category>
    <category name="Pins" displayName="$(string.Cat_Pins)">
      <parentCategory ref="Startline"/>
    </category>
    <category name="Search" displayName="$(string.Cat_Search)">
      <parentCategory ref="Startline"/>
    </category>
    <category name="General" displayName="$(string.Cat_General)">
      <parentCategory ref="Startline"/>
    </category>
    <category name="Limits" displayName="$(string.Cat_Limits)">
      <parentCategory ref="Startline"/>
    </category>
