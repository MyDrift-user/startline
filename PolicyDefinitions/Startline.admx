      <supportedOn ref="SUPPORTED_Startline"/>
      <elements>
        <enum id="Value" valueName="Experience" required="true">
          <item displayName="$(string.I_Experience_0)">
            <value>
              <string>Windows11</string>
            </value>
          </item>
          <item displayName="$(string.I_Experience_1)">
            <value>
              <string>Windows10</string>
            </value>
          </item>
          <item displayName="$(string.I_Experience_2)">
            <value>
              <string>Windows7</string>
            </value>
          </item>
          <item displayName="$(string.I_Experience_3)">
            <value>
              <string>WindowsXp</string>
            </value>
          </item>
          <item displayName="$(string.I_Experience_4)">
            <value>
              <string>Startline</string>
            </value>
          </item>
        </enum>
      </elements>
    </policy>
